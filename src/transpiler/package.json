{
  "name": "@gmloop/transpiler",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@gmloop/core": "workspace:*",
    "@gmloop/parser": "workspace:*",
    "@gmloop/semantic": "workspace:*"
  },
  "devDependencies": {
    "typescript": "catalog:"
  },
  "scripts": {
    "build:types": "tsc -b tsconfig.json",
    "clean:types": "rm -rf dist",
    "test": "pnpm run build:types && node --test-force-exit --test dist/test/*.test.js dist/test/performance/*.test.js"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
