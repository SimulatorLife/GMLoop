{
  "scopeName": "markdown.gml.codeblock",
  "injectionSelector": "L:text.html.markdown",
  "patterns": [
    {
      "include": "#gml-code-block"
    }
  ],
  "repository": {
    "gml-code-block": {
      "begin": "(^|\\\\G)(\\\\s*)(`{3,}|~{3,})\\\\s*(?i:(gml))\\\\b",
      "beginCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        },
        "4": {
          "name": "fenced_code.block.language.markdown"
        }
      },
      "end": "(^|\\\\G)(\\\\s*)(\\\\3)\\\\s*$",
      "endCaptures": {
        "3": {
          "name": "punctuation.definition.markdown"
        }
      },
      "contentName": "source.gml",
      "patterns": [
        {
          "include": "source.gml"
        }
      ]
    }
  }
}
