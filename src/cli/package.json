{
  "name": "@gmloop/cli",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "gmloop": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "config": {
    "root_path": "."
  },
  "scripts": {
    "build:types": "tsc -b tsconfig.json && chmod +x dist/index.js",
    "clean:types": "rm -rf dist",
    "test": "pnpm run build:types && node --disable-warning=ExperimentalWarning --test-force-exit --test dist/test/*.test.js"
  },
  "dependencies": {
    "@gmloop/agent-pack": "workspace:*",
    "@gmloop/core": "workspace:*",
    "@gmloop/fixture-runner": "workspace:*",
    "@gmloop/format": "workspace:*",
    "@gmloop/lint": "workspace:*",
    "@gmloop/parser": "workspace:*",
    "@gmloop/refactor": "workspace:*",
    "@gmloop/runtime-wrapper": "workspace:*",
    "@gmloop/semantic": "workspace:*",
    "@gmloop/transpiler": "workspace:*",
    "@gmloop/ui": "workspace:*",
    "eslint": "catalog:",
    "ws": "catalog:",
    "commander": "^15",
    "fast-xml-parser": "^5.10.1",
    "gray-matter": "^4.0.3",
    "linkedom": "^0.18.13"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
