{
  "keywords": [
    "begin", "break", "case", "catch", "constructor", "continue", "default", "delete", "do", "else",
    "end", "enum", "exit", "finally", "for", "function", "globalvar", "if", "new", "repeat", "return",
    "static", "switch", "then", "throw", "try", "until", "var", "while", "with"
  ],
  "builtinConstants": [
    "all", "false", "global", "infinity", "NaN", "noone", "other", "pi", "pointer_invalid",
    "pointer_null", "self", "true", "undefined"
  ],
  "wordOperators": ["and", "div", "mod", "not", "or", "xor"],
  "symbolOperators": [
    "??=", "<<=", ">>=", "**", "++", "--", ":=", "??", "<<", ">>", "<=", ">=", "==", "!=",
    "<>", "&&", "||", "^^", "*=", "/=", "+=", "-=", "%=", "&=", "^=", "|=", "+", "-", "~",
    "!", "*", "/", "%", "<", ">", "=", "&", "^", "|", "?"
  ],
  "directives": ["#define", "#endregion", "#macro", "#region"],
  "textMateScopes": {
    "builtin-constant": "constant.language.gml",
    "comment": "comment.gml",
    "directive": "keyword.control.directive.gml",
    "enum-member": "variable.other.enummember.gml",
    "enum-name": "entity.name.enum.gml",
    "function-name": "entity.name.function.gml",
    "identifier": "variable.other.gml",
    "keyword": "keyword.control.gml",
    "number": "constant.numeric.gml",
    "operator": "keyword.operator.gml",
    "plain": "source.gml",
    "property-access": "variable.other.property.gml",
    "punctuation": "punctuation.gml",
    "string": "string.quoted.gml",
    "type-name": "entity.name.type.gml",
    "variable-declaration": "variable.other.readwrite.gml",
    "variable-parameter": "variable.parameter.gml"
  }
}
