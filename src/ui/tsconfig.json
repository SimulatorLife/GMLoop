{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "outDir": "./dist",
    "tsBuildInfoFile": "./dist/.tsbuildinfo",
    "paths": {
      "@gmloop/cli": ["../cli/index.ts"],
      "@gmloop/core": ["../core/index.ts"],
      "@gmloop/fixture-runner": ["../fixture-runner/index.ts"],
      "@gmloop/format": ["../format/index.ts"],
      "@gmloop/lint": ["../lint/index.ts"],
      "@gmloop/mcp": ["../mcp/index.ts"],
      "@gmloop/parser": ["../parser/index.ts"],
      "@gmloop/refactor": ["../refactor/index.ts"],
      "@gmloop/runtime-wrapper": ["../runtime-wrapper/index.ts"],
      "@gmloop/semantic": ["../semantic/index.ts"],
      "@gmloop/transpiler": ["../transpiler/index.ts"],
      "@gmloop/ui": ["./index.ts"]
    }
  },
  "references": [
    { "path": "../core" },
    { "path": "../parser" },
    { "path": "../format" },
    { "path": "../refactor" },
    { "path": "../lint" }
  ],
  "include": ["index.ts", "src/**/*.ts", "test/**/*.ts"],
  "exclude": ["dist", "tmp", "node_modules"]
}
