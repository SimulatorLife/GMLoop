{
  "name": "@gmloop/ui",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:web": "vite build --config ./vite.config.ts",
    "build:types": "tsc -b tsconfig.json",
    "clean:types": "rm -rf dist",
    "dev": "vite --config ./vite.config.ts",
    "preview": "vite preview --config ./vite.config.ts",
    "test": "pnpm run build:types && node --test-force-exit --test \"dist/test/*.test.js\""
  },
  "dependencies": {
    "diff": "^9.0.0",
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "vite": "^8.0.16",
    "@gmloop/core": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
