{
  "name": "@gmloop/lint",
  "version": "0.0.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build:types": "tsc -b tsconfig.json",
    "clean:types": "rm -rf dist",
    "test": "pnpm run build:types && node --test 'dist/test/**/*.test.js'"
  },
  "dependencies": {
    "@gmloop/core": "workspace:*",
    "@gmloop/parser": "workspace:*"
  },
  "peerDependencies": {
    "eslint": "catalog:"
  },
  "devDependencies": {
    "@gmloop/fixture-runner": "workspace:*",
    "eslint": "catalog:",
    "typescript": "catalog:"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
