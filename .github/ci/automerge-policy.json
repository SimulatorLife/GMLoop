{
  "schemaVersion": 2,
  "testShardCount": 5,
  "maxParallelValidations": 2,
  "maxInfrastructureRetries": 1,
  "shardWatchdogMs": 1500000,
  "commandWatchdogMs": 1200000,
  "goldenFixturePatterns": [
    "^test/fixtures/.*\\.gml$",
    "^src/parser/test/.*\\.gml$",
    "^src/refactor/test/fixtures/.*\\.gml$",
    "^src/format/test/fixtures/.*\\.gml$",
    "^src/lint/test/.*\\.gml$"
  ],
  "trustedCiPatterns": [
    "^\\.github/",
    "^src/cli/(?:src/commands/ci-automerge-(?:evidence|gate|state)\\.ts|test/ci-automerge-state\\.test\\.ts)$",
    "(?:^|/)package\\.json$",
    "^pnpm-lock\\.yaml$",
    "^pnpm-workspace\\.yaml$",
    "^\\.npmrc$",
    "^\\.pnpmfile\\.cjs$",
    "^\\.gitmodules$",
    "^vendor/",
    "^eslint\\.config\\.js$",
    "^\\.nvmrc$",
    "(?:^|/)tsconfig(?:\\.[^/]+)?\\.json$"
  ]
}
