{
  "github.copilot.chat.mcp.enabled": true,
  "github.copilot.chat.mcp.servers": {
    "gmloop-mcp": {
      "command": "node",
      "args": [
        "${workspaceFolder}/src/mcp/dist/src/main.js"
      ]
    },
    "lsp": {
      "type": "stdio",
      "command": "pnpm",
      "tools": ["*"],
      "args": ["exec", "lsp-mcp-server"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "tools": [
        "*"
      ],
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  }
}