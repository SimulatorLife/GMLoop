{
  "mcpServers": {
    "lsp": {
      "type": "stdio",
      "command": "pnpm",
      "tools": ["*"],
      "args": ["exec", "lsp-mcp-server"]
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "tools": [
        "*"
      ],
      "args": [
        "@playwright/mcp@latest"
      ]
    }
  }
}
