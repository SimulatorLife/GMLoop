{
  "$version": 3,
  "model": {
    "name": "qwen3:1.7b",
    "skipLoopDetection": true,
    "skipStartupContext": true,
    "maxSessionTurns": 12,
    "generationConfig": {
      "timeout": 1200000,
      "maxRetries": 0,
      "samplingParams": {
        "max_tokens": 2048
      }
    },
    "chatCompression": {
      "contextPercentageThreshold": 0.6
    }
  },
  "tools": {
    "approvalMode": "yolo"
  },
  "security": {
    "auth": {
      "selectedType": "openai"
    }
  },
  "modelProviders": {
    "openai": [
      {
        "id": "qwen3:1.7b",
        "name": "Qwen3 1.7B via Ollama",
        "envKey": "OPENAI_API_KEY",
        "baseUrl": "http://127.0.0.1:11434/v1"
      }
    ]
  },
  "permissions": {
    "deny": [
      "WebSearch",
      "WebFetch"
    ]
  },
  "general": {
    "checkpointing": {
      "enabled": true
    }
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "context": {
    "fileName": [
      "AGENTS.md",
      "docs/README.md"
    ]
  },
  "ui": {
    "accessibility": {
      "enableLoadingPhrases": false
    }
  },
  "advanced": {
    "excludedEnvVars": [
      "DEBUG",
      "DEBUG_MODE"
    ]
  }
}