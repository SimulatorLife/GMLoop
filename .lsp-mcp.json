{
  "servers": [
    {
      "id": "typescript",
      "extensions": [".ts", ".tsx"],
      "languageIds": ["typescript", "typescriptreact"],
      "command": "pnpm",
      "args": ["exec", "typescript-language-server", "--stdio"],
      "rootPatterns": ["tsconfig.json", "package.json", "pnpm-workspace.yaml"]
    }
  ],
  "requestTimeout": 60000,
  "autoStart": true,
  "logLevel": "warn",
  "idleTimeout": 1800000
}