{
  "$schema": "https://app.kilo.ai/config.json",
  "skills": {
    "paths": [
      ".agents/skills"
    ]
  },
  "experimental": {
    "openTelemetry": false,
  },
  // Default model
  // "model": "minimax/MiniMax-M3",
  // "small_model": "minimax/MiniMax-M3",
  "model": "openai-compatible/MiniMax-M3",
  "small_model": "openai-compatible/MiniMax-M3",
  "default_agent": "code",
  "permission": {
    "*": {
      "*": "allow",
      "dist/**": "deny",
      "**/dist/**": "deny",
      "node_modules/**": "deny",
      "**/node_modules/**": "deny",
      ".pnpm-store/**": "deny",
      "**/.pnpm-store/**": "deny",
      ".gmloop/**": "deny",
      "**/.gmloop/**": "deny",
      ".git/**": "deny",
      ".codex/**": "deny",
      ".qwen/**": "deny",
      ".kilo/**": "deny",
      ".kilocode/**": "deny",
      ".gemini/**": "deny",
      ".vscode/**": "deny",
      ".husky/**": "deny",
      ".github/**": "deny",
      ".editorconfig": "deny",
      ".nvmrc": "deny",
      ".gitmodules": "deny",
      ".aiexclude": "deny",
      ".prettier*": "deny",
      "opencode.jsonc": "deny",
      "pnpm-lock.yaml": "deny",
      "scripts/**": "deny",
      "resources/antlr/**": "deny",
      "**/*.js": "deny"
    },
    "edit": {
      "vendor/**": "deny",
      "AGENTS.md": "deny",
      "eslint.config.js": "deny",
      ".agents/**": "deny",
      "resources/**": "deny",
      "src/parser/generated/**": "deny",
      "src/parser/.antlr/**": "deny",
      "**/*.gml": "deny",
      "**/*.yy": "deny",
      "**/*.yyp": "deny"
    },
    "grep": "allow",
    "glob": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "webfetch": "deny",
    "websearch": "deny",
    "question": "deny",
    "task": "deny", // Task tool is used to spawn subagents (val. is overwritten for 'code' agent)
  },
  "provider": {
    "openai-compatible": {
      "options": {
        "apiKey": "{env:MINIMAX_API_KEY}",
        "baseURL": "https://api.minimax.io/v1",
        "timeout": 300000,
        "chunkTimeout": 60000
      },
      "models": {
        "MiniMax-M3": {
          "id": "MiniMax-M3",
          "name": "MiniMax M3",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "limit": {
            "context": 524288,
            "input": 500000,
            "output": 8192
          },
          "options": {
            "thinking": {
              "type": "adaptive"
            },
            "reasoning_split": false
          }
        }
      }
    }
  },
  "instructions": [
    "AGENTS.md"
  ],
  "mcp": {
    "gmloop": {
      "type": "local",
      "command": [
        "pnpm",
        "--filter",
        "@gmloop/mcp",
        "start"
      ],
      "enabled": true
    }
  },
  "agent": {
    "code": {
      "description": "Default GMLoop implementation agent. Attacks each task from multiple angles using subagents, then integrates the best result.",
      "mode": "primary",
      "model": "openai-compatible/MiniMax-M3",
      "prompt": "You are the orchestration coding agent for GMLoop. For any and all edits, exploration, test-running, etc. you must invoke the Task tool with 5 parallel gmloop-code-worker subagents to delegate the work. Use the subagents to attack the problem from multiple angles and split the work. Give each subagent a small explicit assignment, scoped area to work within, and ask each to return concise findings, relevant files, recommended changes, risks, and a summary of any/all changes it made. After all subagents return, synthesize their findings, reconcile divergent/duplicate changes, choose the best plan or reconcile conflicts, run relevant validation, and summarize what changed. Preserve GMLoop conventions, prefer existing abstractions, avoid unrelated rewrites, and keep changes scoped. Aim to maintain a swarm of around 5 subagents working in parallel. You cannot write, so you MUST delegate to subagents for all file edits.",
      "permission": {
        "edit": "deny",
        "bash": {
          "*": "deny",
          "git status*": "allow",
          "git diff*": "allow",
          "rg *": "allow",
          "pnpm test*": "allow"
        },
        "task": {
          // Can only spawn gmloop-code-worker subagents
          "gmloop-code-worker": "allow"
        }
      }
    },
    "gmloop-code-worker": {
      "description": "General-purpose GMLoop coding subagent. Use multiple instances of this agent to analyze or implement different aspects of the same task in isolation.",
      "mode": "subagent",
      "model": "openai-compatible/MiniMax-M3",
      "prompt": "{file:./.agents/prompts/gmloop-code-worker.txt}",
      "steps": 30,
      "hidden": true,
      "temperature": 0.9,
      "permission": {
        "task": {
          "*": "deny"
        }
      }
    }
  },
  "snapshot": true,
  "tool_output": {
    "max_lines": 1000,
    "max_bytes": 32768
  },
  "compaction": {
    "auto": true,
    "prune": true,
    "tail_turns": 2,
    "reserved": 8192
  },
}
