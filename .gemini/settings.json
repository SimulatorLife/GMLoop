{
  "model": {
    "name": "auto",
    "maxSessionTurns": 500,
    "compressionThreshold": 0.6
  },
  "context": {
    "fileFiltering": {
      "respectGeminiIgnore": false,
      "customIgnoreFilePaths": [
        ".aiexclude"
      ]
    }
  },
  "experimental": {
    "useModelRouter": true
  },
  "security": {
    "folderTrust": {
      "enabled": false
    }
  },
  "ui": {
    "accessibility": {
      "enableLoadingPhrases": false
    },
    "showCitations": true,
    "showMemoryUsage": true,
    "hideContextSummary": false,
    "loadingPhrases": "off"
  },
  "general": {
    "plan": {
      "enabled": false
    },
    "previewFeatures": false,
    "checkpointing": {
      "enabled": false
    },
    "retryFetchErrors": true,
    "sessionRetention": {
      "enabled": true
    }
  },
  "billing": {
    "overageStrategy": "never"
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "tools": {
    "useRipgrep": false,
    "autoAccept": true,
    "truncateToolOutputThreshold": 4000,
    "disableLLMCorrection": true
  },
  "useWriteTodos": false
}
