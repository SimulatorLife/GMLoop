{
  "model": {
    "name": "gemini-2.5-flash-lite",
    "maxSessionTurns": 24,
    "compressionThreshold": 0.6
  },
  "ui": {
    "accessibility": {
      "disableLoadingPhrases": true
    },
    "showCitations": true,
    "showMemoryUsage": true,
    "hideContextSummary": false
  },
  "general": {
    "previewFeatures": false,
    "checkpointing": {
      "enabled": true
    },
    "retryFetchErrors": true,
    "sessionRetention": {
      "enabled": true,
      "maxAge": "7d",
      "maxCount": 10
    }
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "tools": {
    "autoAccept": true,
    "useRipgrep": true,
    "truncateToolOutputThreshold": 16000,
    "disableLLMCorrection": true,
    "exclude": [

      "tracker_create_task",
      "tracker_update_task",
      "tracker_get_task",
      "tracker_list_tasks",
      "tracker_add_dependency",
      "tracker_visualize"
    ],
    "core": [
      "run_shell_command(cat)",
      "run_shell_command(cd)",
      "run_shell_command(echo)",
      "run_shell_command(sort)",
      "run_shell_command(uniq)",
      "run_shell_command(touch)",
      "run_shell_command(grep)",
      "run_shell_command(head)",
      "run_shell_command(tail)",
      "run_shell_command(timeout)",
      "run_shell_command(mkdir)",
      "run_shell_command(rm)",
      "run_shell_command(cp)",
      "run_shell_command(mv)",
      "run_shell_command(awk)",
      "run_shell_command(sed)",
      "run_shell_command(pwd)",
      "run_shell_command(node)",
      "run_shell_command(npm)",
      "run_shell_command(pnpm)",
      "run_shell_command(ls)",
      "run_shell_command(find)",
      "run_shell_command(rg)",
      "run_shell_command(jq)",
      "run_shell_command(xargs)",
      "run_shell_command(wc)",
      "run_shell_command(cut)",
      "run_shell_command(tr)",
      "run_shell_command(sleep)",
      "run_shell_command(file)",
      "run_shell_command(printf)",
      "run_shell_command(git add)",
      "run_shell_command(git branch)",
      "run_shell_command(git checkout)",
      "run_shell_command(git commit)",
      "run_shell_command(git config)",
      "run_shell_command(git diff)",
      "run_shell_command(git fetch)",
      "run_shell_command(git log)",
      "run_shell_command(git merge-base)",
      "run_shell_command(git push)",
      "run_shell_command(git remote)",
      "run_shell_command(git reset)",
      "run_shell_command(git rev-parse)",
      "run_shell_command(git show)",
      "run_shell_command(exit)",
      "run_shell_command(git status)",
      "run_shell_command(git submodule)",
      "run_shell_command(git switch)",
      "run_shell_command(pgrep)",
      "run_shell_command(gh)",
      "read_file",
      "read_many_files",
      "write_file",
      "replace",
      "list_directory",
      "glob",
      "grep_search"
    ]
  },
  "useWriteTodos": false,
  "experimental":{
    "useModelRouter": false,
    "codebaseInvestigatorSettings": {
      "enabled": false,
      "maxTimeMinutes": 4,
      "thinkingBudget": 2048
    }
  }
}
