{
  "model": {
    "name": "gemini-2.5-flash",
    "maxSessionTurns": 24,
    "compressionThreshold": 0.6
  },
  "policyPaths": [
    ".gemini/policy/tools.toml"
  ],
  "context": {
    "fileName": "AGENTS.md",
    "fileFiltering": {
      "customIgnoreFilePaths": [
        ".aiexclude"
      ]
    }
  },
  "security": {
    "folderTrust": {
      "enabled": false
    }
  },
  "ui": {
    "accessibility": {
      "enableLoadingPhrases": false
    },
    "showCitations": true,
    "showMemoryUsage": true,
    "hideContextSummary": false,
    "loadingPhrases": "off"
  },
  "general": {
    "previewFeatures": false,
    "checkpointing": {
      "enabled": false
    },
    "retryFetchErrors": true,
    "sessionRetention": {
      "enabled": true,
      "maxAge": "7d",
      "maxCount": 10
    }
  },
  "billing": {
    "overageStrategy": "never"
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "tools": {
    "autoAccept": true,
    "truncateToolOutputThreshold": 16000,
    "disableLLMCorrection": true
  },
  "useWriteTodos": false,
  "experimental": {
    "useModelRouter": true
  },
  "agents": {
    "overrides": {
      "codebase_investigator": {
        "enabled": false,
        "runConfig": {
          "maxTimeMinutes": 4
        },
        "modelConfig": {
          "generateContentConfig": {
            "thinkingConfig": {
              "thinkingBudget": 2048
            }
          }
        }
      }
    }
  }
}