{
  "policyPaths": [
    ".gemini/policy"
  ],
  "context": {
    "fileFiltering": {
      "customIgnoreFilePaths": [
        ".aiexclude"
      ]
    }
  },
  "security": {
    "folderTrust": {
      "enabled": false
    }
  },
  "ui": {
    "accessibility": {
      "enableLoadingPhrases": false
    },
    "showCitations": true,
    "showMemoryUsage": true,
    "hideContextSummary": false,
    "loadingPhrases": "off"
  },
  "general": {
    "plan": {
      "enabled": false
    },
    "previewFeatures": false,
    "checkpointing": {
      "enabled": false
    },
    "retryFetchErrors": true,
    "sessionRetention": {
      "enabled": false
    }
  },
  "billing": {
    "overageStrategy": "never"
  },
  "privacy": {
    "usageStatisticsEnabled": false
  },
  "tools": {
    "core": [
      "LSTool",
      "ReadFileTool",
      "RipGrepTool",
      "GlobTool",
      "EditTool",
      "WriteFileTool",
      "ActivateSkillTool",
      "run_shell_command"
    ],
    "useRipgrep": true,
    "autoAccept": true,
    "truncateToolOutputThreshold": 4000,
    "disableLLMCorrection": true,
    "allow": [
      "run_shell_command"
    ]
  },
  "useWriteTodos": false,
  "experimental": {
    "useModelRouter": true
  },
  "agents": {
    "overrides": {
      "codebase_investigator": {
        "enabled": false,
        "runConfig": {
          "maxTimeMinutes": 4
        },
        "modelConfig": {
          "generateContentConfig": {
            "thinkingConfig": {
              "thinkingBudget": 2048
            }
          }
        }
      }
    }
  }
}
